\name{cw_adapt_gate}
\alias{cw_adapt_gate}
\title{Adapt a gate to each sample}
\usage{
cw_adapt_gate(population, group_by = NULL, cw = cw_default())
}
\arguments{
\item{population}{Population name, path ("Lymphocytes/Single cells/CD3+") or id; "All events" or omitted for all events. Required; a string.}
\item{group_by}{Sample metadata field whose samples keep one gate, adapted on their pooled events (e.g. donor or subject); default: each sample alone. Optional; a string.}
\item{cw}{A connection from \code{\link{cw_connect}} (default: the last one made).}
}
\value{
A \code{cytoweave_result}: the \code{message} and the \code{data} CytoWeave answered with.
